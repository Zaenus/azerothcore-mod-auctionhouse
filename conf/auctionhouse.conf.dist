[worldserver]

########################################
# AUCTION HOUSE BOT (Economy Balancer)
########################################

# AuctionHouseBot.Enabled
#     Description: Enable the Auction House Bot module
#     Default:     1 - Enabled
#                  0 - Disabled
AuctionHouseBot.Enabled = 1

# AuctionHouseBot.UpdateInterval
#     Description: How often the bot runs its buy/sell cycle (in milliseconds)
#     Default:     300000 (5 minutes)
AuctionHouseBot.UpdateInterval = 300000

# AuctionHouseBot.MaxActiveAuctionsPerBot
#     Description: Maximum number of active auctions per bot
#     Default:     150
AuctionHouseBot.MaxActiveAuctionsPerBot = 150

# AuctionHouseBot.MaxGoldPerBot
#     Description: Maximum gold a bot can hold (in copper)
#     Default:     10000000 (1000 gold)
AuctionHouseBot.MaxGoldPerBot = 10000000

# AuctionHouseBot.StartingGoldPerBot
#     Description: Starting gold for each bot on first creation (in copper)
#     Default:     1000000 (100 gold)
AuctionHouseBot.StartingGoldPerBot = 1000000

# AuctionHouseBot.MinProfitMargin
#     Description: Minimum profit margin for buying/selling (0.0 - 1.0)
#     Default:     0.15 (15%)
AuctionHouseBot.MinProfitMargin = 0.15

# AuctionHouseBot.MaxBuyPricePercent
#     Description: Maximum percentage of market value to pay when buying (0.0 - 1.0)
#     Default:     0.80 (80%)
AuctionHouseBot.MaxBuyPricePercent = 0.80

# AuctionHouseBot.MinSellPricePercent
#     Description: Minimum percentage of market value when selling (1.0+)
#     Default:     1.10 (110%)
AuctionHouseBot.MinSellPricePercent = 1.10

# AuctionHouseBot.PriceHistoryDays
#     Description: Number of days of price history to retain
#     Default:     30
AuctionHouseBot.PriceHistoryDays = 30

# AuctionHouseBot.MinItemLevel
#     Description: Minimum item level for bot to consider
#     Default:     1
AuctionHouseBot.MinItemLevel = 1

# AuctionHouseBot.MaxItemLevel
#     Description: Maximum item level for bot to consider
#     Default:     277
AuctionHouseBot.MaxItemLevel = 277

# AuctionHouseBot.AllowedItemClasses
#     Description: Comma-separated item classes bot can trade (2=Consumables, 4=Armor, 7=Trade Goods, 11=Misc)
#     Default:     "2,4,7,11"
AuctionHouseBot.AllowedItemClasses = "2,4,7,11"

# AuctionHouseBot.BlacklistedItems
#     Description: Comma-separated item entries to never trade
#     Default:     ""
AuctionHouseBot.BlacklistedItems = ""

# AuctionHouseBot.BotAccountPrefix
#     Description: Prefix for bot account names
#     Default:     "AHBot_"
AuctionHouseBot.BotAccountPrefix = "AHBot_"

# AuctionHouseBot.BotCountPerFaction
#     Description: Number of bots per faction (Alliance, Horde, Neutral)
#     Default:     1
AuctionHouseBot.BotCountPerFaction = 1

# AuctionHouseBot.MaxItemsPerCycle
#     Description: Maximum buy/sell operations per update cycle
#     Default:     20
AuctionHouseBot.MaxItemsPerCycle = 20

# AuctionHouseBot.RelistThresholdHours
#     Description: Hours before relisting unsold items
#     Default:     12
AuctionHouseBot.RelistThresholdHours = 12

# AuctionHouseBot.UnderpriceThreshold
#     Description: Alert/buy if item is below this percentage of market value
#     Default:     0.50 (50%)
AuctionHouseBot.UnderpriceThreshold = 0.50

# AuctionHouseBot.Restock.Enabled
#     Description: Continuously replenish bot inventory so the AH keeps a steady inflow of items
#     Default:     1 - Enabled
#                  0 - Disabled
AuctionHouseBot.Restock.Enabled = 1

# AuctionHouseBot.Restock.MinStockPerBot
#     Description: Keep at least this many unlisted items in each bot's inventory
#     Default:     40
AuctionHouseBot.Restock.MinStockPerBot = 40

# AuctionHouseBot.Restock.MaxPerCycle
#     Description: Maximum new items added to a bot's inventory per restock cycle
#     Default:     15
AuctionHouseBot.Restock.MaxPerCycle = 15

# AuctionHouseBot.Restock.MaxQuality
#     Description: Maximum item quality the restocker will supply (0=Poor, 1=Common, 2=Uncommon, 3=Rare, 4=Epic)
#     Default:     3 (Rare)
AuctionHouseBot.Restock.MaxQuality = 3

# AuctionHouseBot.PriceVariancePercent
#     Description: Random price jitter applied to listings as percentage of market value
#     Default:     15.0
AuctionHouseBot.PriceVariancePercent = 15.0

# AuctionHouseBot.RefillGoldBelow
#     Description: If a bot's gold drops below this amount (copper) it is refilled back to StartingGoldPerBot
#     Default:     100000 (10 gold)
AuctionHouseBot.RefillGoldBelow = 100000


